<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow / Halo -->
    <path
        android:pathData="M54,22 C71.67,22 86,36.33 86,54 C86,71.67 71.67,86 54,86 C36.33,86 22,71.67 22,54 C22,36.33 36.33,22 54,22 Z"
        android:strokeWidth="12"
        android:strokeAlpha="0.25"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40"
                android:type="radial">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#0066FF" android:offset="0.8" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clock Ring (Futuristic Neon Blue Circle) -->
    <path
        android:pathData="M54,26 C70.57,26 82,37.43 82,54 C82,70.57 70.57,82 54,82 C37.43,82 26,70.57 26,54 C26,37.43 37.43,26 54,26 Z"
        android:strokeWidth="3.5"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#00FFFF" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="0.5" />
                <item android:color="#2979FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clock notches -->
    <path
        android:pathData="M54,26 L54,32 M82,54 L76,54 M54,82 L54,76 M26,54 L32,54"
        android:strokeWidth="2.5"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />

    <!-- Clock hands -->
    <path
        android:pathData="M54,54 L54,40 M54,54 L66,58"
        android:strokeWidth="2"
        android:strokeColor="#80D8FF"
        android:strokeLineCap="round" />

    <!-- Checkmark Neon Glow Core -->
    <path
        android:pathData="M40,53 L49,62 L70,41"
        android:strokeWidth="7"
        android:strokeAlpha="0.6"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Checkmark Sharp White Foreground -->
    <path
        android:pathData="M40,53 L49,62 L70,41"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>
